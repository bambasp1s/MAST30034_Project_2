    "# State & Gender mapping dictionaries\n",
    "STATE_MAP = {\"ACT\": 1, \"NSW\": 2, \"NT\": 3, \"QLD\": 4, \"SA\": 5, \"TAS\": 6, \"VIC\": 7, \"WA\": 8}\n",
    "GENDER_MAP = {\"Male\": 1, \"Female\": 2, \"Undisclosed\": 0}\n",
    "\n",
    "def add_temporal_features(df):\n",
    "    \"\"\"Extract calendar, cyclical, and trend features from order_datetime.\"\"\"\n",
    "    result = df.copy()\n",
    "    date = pd.to_datetime(result[\"order_datetime\"].astype(str), errors=\"coerce\")\n",
    "    \n",
    "    result[\"year\"] = date.dt.year.fillna(2021).astype(\"int16\")\n",
    "    result[\"month\"] = date.dt.month.fillna(1).astype(\"int8\")\n",
    "    result[\"day\"] = date.dt.day.fillna(1).astype(\"int8\")\n",
    "    result[\"day_of_week\"] = date.dt.dayofweek.fillna(0).astype(\"int8\")\n",
    "    result[\"day_of_year\"] = date.dt.dayofyear.fillna(1).astype(\"int16\")\n",
    "    result[\"week_of_year\"] = date.dt.isocalendar().week.fillna(1).astype(\"int16\")\n",
    "    result[\"is_weekend\"] = result[\"day_of_week\"].isin([5, 6]).astype(\"int8\")\n",
    "    result[\"days_since_start\"] = (date - pd.Timestamp(\"2021-01-01\")).dt.days.fillna(0).astype(\"int16\")\n",
    "    \n",
    "    # Cyclical encodings (captures monthly and weekly seasonality smoothly)\n",
    "    result[\"sin_month\"] = np.sin(2 * np.pi * result[\"month\"] / 12.0).astype(np.float32)\n",
    "    result[\"cos_month\"] = np.cos(2 * np.pi * result[\"month\"] / 12.0).astype(np.float32)\n",
    "    result[\"sin_dow\"] = np.sin(2 * np.pi * result[\"day_of_week\"] / 7.0).astype(np.float32)\n",
    "    result[\"cos_dow\"] = np.cos(2 * np.pi * result[\"day_of_week\"] / 7.0).astype(np.float32)\n",
    "    \n",
    "    # Monetary transformations (if dollar_value present)\n",
    "    if \"dollar_value\" in result.columns:\n",
    "        result[\"amount_log\"] = np.log1p(result[\"dollar_value\"].clip(lower=0)).astype(np.float32)\n",
    "        result[\"is_round_dollar\"] = (result[\"dollar_value\"] % 10 == 0).astype(\"int8\")\n",
    "    else:\n",
    "        result[\"dollar_value\"] = 0.0\n",
    "        result[\"amount_log\"] = 0.0\n",
    "        result[\"is_round_dollar\"] = 0\n",
    "        \n",
    "    return result\n",
    "\n",
    "\n",
    "def add_consumer_features(df, consumer_profile):\n",
    "    \"\"\"Enrich dataframe with consumer demographics, state, gender, postcode, and SA2 features.\"\"\"\n",
    "    result = df.copy()\n",
    "    if \"user_id\" in result.columns and \"state\" not in result.columns:\n",
    "        result = result.merge(\n",
    "            consumer_profile[[\n",
    "                \"user_id\", \"state\", \"gender\", \"postcode\",\n",
    "                \"SA2_CODE_2021\", \"mb_count\", \"poa_total\", \"ratio\"\n",
    "            ]],\n",
    "            on=\"user_id\",\n",
    "            how=\"left\"\n",
    "        )\n",
    "    \n",
    "    # Encode categorical features numerically (with safe fallback if missing e.g. for merchant labels)\n",
    "    if \"state\" in result.columns:\n",
    "        result[\"state_code\"] = result[\"state\"].map(STATE_MAP).fillna(0).astype(\"int8\")\n",
    "        result[\"gender_code\"] = result[\"gender\"].map(GENDER_MAP).fillna(0).astype(\"int8\")\n",
    "        result[\"postcode_num\"] = pd.to_numeric(result[\"postcode\"], errors=\"coerce\").fillna(0).astype(np.float32)\n",
    "        result[\"sa2_num\"] = pd.to_numeric(result.get(\"SA2_CODE_2021\", 0), errors=\"coerce\").fillna(0).astype(np.float32)\n",
    "        result[\"mb_count\"] = pd.to_numeric(result.get(\"mb_count\", 0), errors=\"coerce\").fillna(0).astype(np.float32)\n",
    "        result[\"poa_total\"] = pd.to_numeric(result.get(\"poa_total\", 0), errors=\"coerce\").fillna(0).astype(np.float32)\n",
    "        result[\"ratio\"] = pd.to_numeric(result.get(\"ratio\", 0), errors=\"coerce\").fillna(0).astype(np.float32)\n",
    "    else:\n",
    "        result[\"state_code\"] = 0\n",
    "        result[\"gender_code\"] = 0\n",
    "        result[\"postcode_num\"] = 0.0\n",
    "        result[\"sa2_num\"] = 0.0\n",
    "        result[\"mb_count\"] = 0.0\n",
    "        result[\"poa_total\"] = 0.0\n",
    "        result[\"ratio\"] = 0.0\n",
    "    \n",
    "    return result\n",
    "\n",
    "\n",
    "def add_merchant_features(df, merchant_profile):\n",
    "    \"\"\"Enrich dataframe with merchant tags and category encodings.\"\"\"\n",
    "    result = df.copy()\n",
    "    if \"merchant_abn\" in result.columns and \"primary_tag\" not in result.columns:\n",
    "        result = result.merge(\n",
    "            merchant_profile[[\"merchant_abn\", \"primary_tag\"]],\n",
    "            on=\"merchant_abn\",\n",
    "            how=\"left\"\n",
    "        )\n",
    "    \n",
    "    # High-risk tags / category indicators\n",
    "    if \"primary_tag\" in result.columns:\n",
    "        result[\"is_jewelry\"] = result[\"primary_tag\"].astype(str).str.contains(\"jewel|watch|gold\", case=False, na=False).astype(\"int8\")\n",
    "        result[\"is_electronics\"] = result[\"primary_tag\"].astype(str).str.contains(\"electr|tech|comput\", case=False, na=False).astype(\"int8\")\n",
    "        result[\"is_gift_card\"] = result[\"primary_tag\"].astype(str).str.contains(\"gift|card|voucher\", case=False, na=False).astype(\"int8\")\n",
    "        result[\"is_apparel\"] = result[\"primary_tag\"].astype(str).str.contains(\"cloth|wear|apparel\", case=False, na=False).astype(\"int8\")\n",
    "    else:\n",
    "        result[\"is_jewelry\"] = 0\n",
    "        result[\"is_electronics\"] = 0\n",
    "        result[\"is_gift_card\"] = 0\n",
    "        result[\"is_apparel\"] = 0\n",
    "        \n",
    "    return result\n",
    "\n",
    "\n",
    "def add_entity_target_encoding(reference, target, entity_col, prefix, smoothing=10.0):\n",
    "    \"\"\"\n",
    "    Smoothed Bayesian target encoding:\n",
    "    weighted_mean = (count * mean + smoothing * global_mean) / (count + smoothing)\n",
    "    Prevents overfitting on entities with very few transactions.\n",
    "    \"\"\"\n",
    "    result = target.copy()\n",
    "    global_mean = reference[\"fraud_probability\"].mean()\n",
    "    \n",
    "    if entity_col not in target.columns or entity_col not in reference.columns:\n",
    "        result[f\"{prefix}_mean\"] = global_mean\n",
    "        result[f\"{prefix}_std\"] = 0.0\n",
    "        result[f\"{prefix}_count\"] = 0.0\n",
    "        return result\n",
    "\n",
    "    stats = reference.groupby(entity_col)[\"fraud_probability\"].agg([\"mean\", \"std\", \"count\"])\n",
    "    stats[f\"{prefix}_mean\"] = (stats[\"count\"] * stats[\"mean\"] + smoothing * global_mean) / (stats[\"count\"] + smoothing)\n",
    "    stats[f\"{prefix}_std\"] = stats[\"std\"].fillna(0.0)\n",
    "    stats[f\"{prefix}_count\"] = np.log1p(stats[\"count\"])\n",
    "    \n",
    "    summary = stats[[f\"{prefix}_mean\", f\"{prefix}_std\", f\"{prefix}_count\"]]\n",
    "    result = result.merge(summary, on=entity_col, how=\"left\")\n",
    "    \n",
    "    result[f\"{prefix}_mean\"] = result[f\"{prefix}_mean\"].fillna(global_mean)\n",
    "    result[f\"{prefix}_std\"] = result[f\"{prefix}_std\"].fillna(0.0)\n",
    "    result[f\"{prefix}_count\"] = result[f\"{prefix}_count\"].fillna(0.0)\n",
    "    \n",
    "    return result\n",
    "\n",
    "\n",
    "FEATURE_COLUMNS = [\n",
    "    # Monetary & transaction\n",
    "    \"dollar_value\", \"amount_log\", \"is_round_dollar\",\n",
    "    # Temporal & seasonality\n",
    "    \"year\", \"month\", \"day\", \"day_of_week\", \"day_of_year\", \"week_of_year\",\n",
    "    \"is_weekend\", \"days_since_start\",\n",
    "    \"sin_month\", \"cos_month\", \"sin_dow\", \"cos_dow\",\n",
    "    # Consumer demographics & geography\n",
    "    \"state_code\", \"gender_code\", \"postcode_num\", \"sa2_num\", \"mb_count\", \"poa_total\", \"ratio\",\n",
    "    # Merchant categories\n",
    "    \"is_jewelry\", \"is_electronics\", \"is_gift_card\", \"is_apparel\",\n",
    "    # Smoothed target encodings\n",
    "    \"consumer_mean\", \"consumer_std\", \"consumer_count\",\n",
    "    \"merchant_mean\", \"merchant_std\", \"merchant_count\",\n",
    "]\n",
    "\n",
    "def make_features(df, consumer_ref, merchant_ref, consumer_profile, merchant_profile):\n",
    "    \"\"\"Unified feature engineering pipeline integrating temporal, spatial, demographic, and entity features.\"\"\"\n",
    "    feat = add_temporal_features(df)\n",
    "    feat = add_consumer_features(feat, consumer_profile)\n",
    "    feat = add_merchant_features(feat, merchant_profile)\n",
    "    feat = add_entity_target_encoding(consumer_ref, feat, \"user_id\", \"consumer\")\n",
    "    feat = add_entity_target_encoding(merchant_ref, feat, \"merchant_abn\", \"merchant\")\n",
    "    \n",
    "    for col in FEATURE_COLUMNS:\n",
    "        if col not in feat.columns:\n",
    "            feat[col] = 0.0\n",
    "            \n",
    "    return feat[FEATURE_COLUMNS].replace([np.inf, -np.inf], np.nan).fillna(0).astype(np.float32)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def make_model():\n",
    "    \"\"\"\n",
    "    Robust ensemble regressor.\n",
    "    Uses HistGradientBoostingRegressor if available, otherwise RandomForestRegressor.\n",
    "    \"\"\"\n",
    "    if HistGradientBoostingRegressor is not None:\n",
    "        return HistGradientBoostingRegressor(\n",
    "            max_iter=150,\n",
    "            learning_rate=0.08,\n",
    "            max_leaf_nodes=31,\n",
    "            min_samples_leaf=20,\n",
    "            l2_regularization=1.0,\n",
    "            random_state=RANDOM_STATE\n",
    "        )\n",
    "    return RandomForestRegressor(\n",
    "        n_estimators=100,\n",
    "        max_features=\"sqrt\",\n",
    "        min_samples_leaf=3,\n",
    "        random_state=RANDOM_STATE,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "\n",
    "\n",
    "def train_model(label_frame, prefix, consumer_profile, merchant_profile):\n",
    "    \"\"\"Train and evaluate the fraud probability prediction model using a time-based 80/20 holdout.\"\"\"\n",
    "    label_frame = label_frame.sort_values(\"order_datetime\").reset_index(drop=True)\n",
    "    split_date = label_frame[\"order_datetime\"].quantile(0.8)\n",
    "    \n",
    "    train_labels = label_frame[label_frame[\"order_datetime\"] < split_date].copy()\n",
    "    valid_labels = label_frame[label_frame[\"order_datetime\"] >= split_date].copy()\n",
    "\n",
    "    # Features for validation\n",
    "    train_features = make_features(train_labels, train_labels, train_labels, consumer_profile, merchant_profile)\n",
    "    valid_features = make_features(valid_labels, train_labels, train_labels, consumer_profile, merchant_profile)\n",
    "    \n",
    "    val_model = make_model()\n",
    "    val_model.fit(train_features, train_labels[\"fraud_probability\"])\n",
    "    \n",
    "    val_preds = np.clip(val_model.predict(valid_features), 0, 100)\n",
    "    actual = valid_labels[\"fraud_probability\"].to_numpy()\n",
    "    errors = np.abs(actual - val_preds)\n",
    "    \n",
    "    val_start = str(valid_labels[\"order_datetime\"].min())[:10] if \"order_datetime\" in valid_labels.columns else \"\"\n",
    "    val_end = str(valid_labels[\"order_datetime\"].max())[:10] if \"order_datetime\" in valid_labels.columns else \"\"\n",
    "    \n",
    "    report = {\n",
    "        \"model\": prefix,\n",
    "        \"train_rows\": len(train_labels),\n",
    "        \"validation_rows\": len(valid_labels),\n",
    "        \"validation_start\": val_start,\n",
    "        \"validation_end\": val_end,\n",
    "        \"mae\": float(mean_absolute_error(actual, val_preds)),\n",
    "        \"rmse\": float(mean_squared_error(actual, val_preds) ** 0.5),\n",
    "        \"r2\": float(r2_score(actual, val_preds)),\n",
    "        \"within_5_points_pct\": float((errors <= 5).mean() * 100),\n",
    "        \"within_10_points_pct\": float((errors <= 10).mean() * 100),\n",
    "    }\n",
    "\n",
    "    # Final model on full history\n",
    "    final_features = make_features(label_frame, label_frame, label_frame, consumer_profile, merchant_profile)\n",
    "    final_model = make_model()\n",
    "    final_model.fit(final_features, label_frame[\"fraud_probability\"])\n",
    "    \n",
    "    return final_model, report\n",
    "\n",
    "\n",
    "# Load training labels\n",
    "consumer_labels = pd.read_csv(PART1_DIR / \"consumer_fraud_probability.csv\")\n",
    "consumer_labels[\"order_datetime\"] = pd.to_datetime(consumer_labels[\"order_datetime\"].astype(str))\n",
    "\n",
    "merchant_labels = pd.read_csv(PART1_DIR / \"merchant_fraud_probability.csv\")\n",
    "merchant_labels[\"order_datetime\"] = pd.to_datetime(merchant_labels[\"order_datetime\"].astype(str))\n",
    "\n",
    "print(\"Training Consumer Fraud Probability Model...\")\n",
    "consumer_model, consumer_report = train_model(consumer_labels, \"Consumer\", consumer_full_profile, merchants)\n",
    "\n",
    "print(\"Training Merchant Fraud Probability Model...\")\n",
    "merchant_model, merchant_report = train_model(merchant_labels, \"Merchant\", consumer_full_profile, merchants)\n",
    "\n",
    "# Save validation report\n",
    "validation_report = pd.DataFrame([consumer_report, merchant_report])\n",
    "validation_report.to_csv(TABLES_DIR / \"model_validation_report.csv\", index=False)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"MODEL VALIDATION REPORT (Time-Based Holdout Split)\")\n",
    "print(\"=\" * 60)\n",
    "display(validation_report)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ------------------------------------------------------------\n",
    "# Batch Predict on Curated Partitions\n",
    "# ------------------------------------------------------------\n",
    "output_columns = [\n",
    "    \"order_id\",\n",
    "    \"order_datetime\",\n",
    "    \"user_id\",\n",
    "    \"merchant_abn\",\n",
    "    \"dollar_value\",\n",
    "    \"consumer_fraud_probability\",\n",
    "    \"merchant_fraud_probability\",\n",
    "    \"fraud_probability\",\n",
    "    \"is_fraud\"\n",
    "]\n",
    "\n",
    "output_path = TABLES_DIR / \"part_2_4_fraud_probability_predictions.csv\"\n",
    "flagged_output_path = TABLES_DIR / \"part_2_4_fraud_probability_predictions_with_flag.csv\"\n",
    "\n",
    "# Locate curated partitions\n",
    "curated_files = sorted(CURATED_DIR.glob(\"*.parquet\"))\n",
    "if not curated_files:\n",
    "    curated_files = sorted((TABLES_DIR / \"combined_parts_2_4.parquet\").glob(\"*.parquet\"))\n",
    "\n",
    "print(f\"Found {len(curated_files)} curated parquet file(s) to score:\")\n",
    "for f in curated_files:\n",
    "    print(f\" - {f.name}\")\n",
    "\n",
    "total_scored_rows = 0\n",
    "first_batch_preview = None\n",
    "\n",
    "for file_idx, parquet_file in enumerate(curated_files):\n",
    "    print(f\"\\nScoring {parquet_file.name}...\")\n",
    "    pf = pq.ParquetFile(parquet_file)\n",
    "    \n",
    "    for batch_idx, batch in enumerate(pf.iter_batches(batch_size=250_000)):\n",
    "        chunk = batch.to_pandas()\n",
    "        \n",
    "        # Build features for current batch\n",
    "        features = make_features(\n",
    "            chunk,\n",
    "            consumer_labels,\n",
    "            merchant_labels,\n",
    "            consumer_full_profile,\n",
    "            merchants\n",
    "        )\n",
    "        \n",
    "        # Predict consumer and merchant probabilities\n",
    "        chunk[\"consumer_fraud_probability\"] = np.clip(consumer_model.predict(features), 0, 100).round(2)\n",
    "        chunk[\"merchant_fraud_probability\"] = np.clip(merchant_model.predict(features), 0, 100).round(2)\n",
    "        \n",
    "        # Combined fraud score (weighted mean) & threshold flag\n",
    "        chunk[\"fraud_probability\"] = (\n",
    "            chunk[\"consumer_fraud_probability\"] * 0.6 + chunk[\"merchant_fraud_probability\"] * 0.4\n",
    "        ).round(2)\n",
    "        chunk[\"is_fraud\"] = chunk[\"fraud_probability\"] >= 80.0\n",
    "        \n",
    "        scored_chunk = chunk[[c for c in output_columns if c in chunk.columns]]\n",
    "        \n",
    "        mode = \"w\" if total_scored_rows == 0 else \"a\"\n",
    "        header = (total_scored_rows == 0)\n",
    "        scored_chunk.to_csv(flagged_output_path, mode=mode, header=header, index=False)\n",
    "        scored_chunk.to_csv(output_path, mode=mode, header=header, index=False)\n",
    "        \n",
    "        total_scored_rows += len(scored_chunk)\n",
    "        if first_batch_preview is None:\n",
    "            first_batch_preview = scored_chunk.head(10).copy()\n",
    "            \n",
    "        del chunk, features, scored_chunk\n",
    "        gc.collect()\n",
    "\n",
    "print(f\"\\n✓ Completed scoring: {total_scored_rows:,} transactions saved to {flagged_output_path}\")\n"
   ]
